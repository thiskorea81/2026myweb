# .env.example — 실제 값을 채운 뒤 파일명을 .env로 바꾸세요.
# 이 파일은 git에 커밋해도 안전합니다. 실제 .env는 절대 커밋하지 마세요.

# Firebase 설정 (Firebase 콘솔 > 프로젝트 설정 > 앱에서 확인)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Gemini API 키 (https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 자율학습 관리자 계정 (AdminView.vue에서 사용)
VITE_ADMIN_ID=your_admin_id
VITE_ADMIN_PW=your_secure_admin_password

# -------------------------------------------------------
# [필수 설정] Firebase Authentication
# Firebase 콘솔 > Authentication > Sign-in method > 이메일/비밀번호 활성화 후,
# "사용자" 탭에서 선생님 계정(이메일 + 비밀번호)을 직접 추가해 주세요.
# -------------------------------------------------------

# [필수 설정] Firebase Storage 규칙
# Firebase 콘솔 > Storage > Rules에 아래 규칙을 적용하세요:
#
# rules_version = '2';
# service firebase.storage {
#   match /b/{bucket}/o {
#     match /student-photos/{allPaths=**} {
#       allow read: if true;
#       allow write: if request.auth != null;
#     }
#   }
# }
